    lbl(s, "â„¹ï¸ O painel flutuante pode ser arrastado pela tela",
        UDim2.new(1,0,0,18), nil, 10, C.BORDER).LayoutOrder = 3

    local mainFlyToggle, getFlying = toggleBtnFn(s,
        "âœˆï¸  Voar: OFF", "âœˆï¸  Voar: ON", C.CARD, C.A2, 4,
        function(st)
            if st then
