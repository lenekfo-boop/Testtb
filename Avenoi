-------------------------------------------------
-- UTILITÃRIOS GUI
-------------------------------------------------
local function corner(parent, radius)
    local c = Instance.new("UICorner", parent)
    c.CornerRadius = UDim.new(0, radius or 8)
    return c
end

local function stroke(parent, color, thickness)
    local s = Instance.new("UIStroke", parent)
    s.Color = color or THEME.BORDER
    s.Thickness = thickness or 1.5
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

local function gradient(parent, c0, c1, rotation)
    local g = Instance.new("UIGradient", parent)
    g.Color = ColorSequence.new(c0 or THEME.ACCENT1, c1 or THEME.ACCENT2)
    g.Rotation = rotation or 90
    return g
end

local function tween(obj, props, t, style, dir)
    local info = TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    TweenService:Create(obj, info, props):Play()
end

local function newLabel(parent, text, size, pos, textSize, color, align, xalign)
    local l = Instance.new("TextLabel", parent)
    l.Size = size
    l.Position = pos or UDim2.new(0,0,0,0)
    l.Text = text
    l.TextSize = textSize or 13
    l.TextColor3 = color or THEME.TEXT
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamBold
    l.TextXAlignment = xalign or Enum.TextXAlignment.Center
    l.TextYAlignment = align or Enum.TextYAlignment.Center
    return l
end

local function newBtn(parent, text, size, pos, bg, textColor, textSize)
    local b = Instance.new("TextButton", parent)
    b.Size = size
    b.Position = pos or UDim2.new(0,0,0,0)
    b.Text = text
    b.TextSize = textSize or 13
    b.TextColor3 = textColor or THEME.WHITE
    b.BackgroundColor3 = bg or THEME.CARD
    b.Font = Enum.Font.GothamBold
    b.AutoButtonColor = false
    corner(b, 8)
    -- hover
    b.MouseEnter:Connect(function()
        tween(b, {BackgroundTransparency = 0.25}, 0.15)
    end)
    b.MouseLeave:Connect(function()
        tween(b, {BackgroundTransparency = 0}, 0.15)
    end)
    b.MouseButton1Down:Connect(function()
        tween(b, {BackgroundTransparency = 0.5}, 0.08)
    end)
    b.MouseButton1Up:Connect(function()
        tween(b, {BackgroundTransparency = 0}, 0.12)
    end)
    return b
end

