local function actionBtn(parent, label, color, lo, callback)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(1, 0, 0, 32)
    b.Text = label
    b.TextSize = 12
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = THEME.WHITE
    b.BackgroundColor3 = color or THEME.ACCENT1
    b.AutoButtonColor = false
    b.LayoutOrder = lo or 99
    corner(b, 7)
    b.MouseEnter:Connect(function() tween(b, {BackgroundTransparency=0.2}, 0.12) end)
    b.MouseLeave:Connect(function() tween(b, {BackgroundTransparency=0}, 0.12) end)
    b.MouseButton1Down:Connect(function() tween(b, {BackgroundTransparency=0.45}, 0.07) end)
    b.MouseButton1Up:Connect(function() tween(b, {BackgroundTransparency=0}, 0.1) end)
    if callback then b.MouseButton1Click:Connect(callback) end
    return b
end

local function toggleBtn(parent, labelOff, labelOn, colorOff, colorOn, lo, callback)
    local state = false
    local b = actionBtn(parent, labelOff, colorOff, lo)
    b.MouseButton1Click:Connect(function()
        state = not state
        if state then
            b.Text = labelOn
            tween(b, {BackgroundColor3 = colorOn}, 0.18)
        else
            b.Text = labelOff
            tween(b, {BackgroundColor3 = colorOff}, 0.18)
        end
        if callback then callback(state) end
    end)
    return b, function() return state end
end

