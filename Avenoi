-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
local antiTrollEnabled = true
local antiTrollGlobal  = true
local lastTrollAlert   = {}
local proximityTime    = {}
local detectionRadius  = 4

local function canAlert(t, v)
    local k = t .. "->" .. v
    if not lastTrollAlert[k] then return true end
    return (tick() - lastTrollAlert[k]) > 5
end

local function setupDiedDetect(plr, char)
    task.spawn(function()
        task.wait(0.5)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        hum.Died:Connect(function()
            if not antiTrollEnabled then return end
            if plr == player and not antiTrollGlobal then return end
            task.wait(0.1)
            for _, op in pairs(Players:GetPlayers()) do
                if op ~= plr and op.Character then
                    local oHRP = op.Character:FindFirstChild("HumanoidRootPart")
                    local vHRP = char:FindFirstChild("HumanoidRootPart")
                    if oHRP and vHRP and (oHRP.Position - vHRP.Position).Magnitude < 15 and canAlert(op.Name, plr.Name) then
                        notifyTroll(op.Name, plr == player and "Te matou!" or "Matou " .. plr.DisplayName .. "!")
                        lastTrollAlert[op.Name .. "->" .. plr.Name] = tick()
                        break
                    end
                end
            end
        end)
    end)
end

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function(char) setupDiedDetect(plr, char) end)
end)
for _, plr in pairs(Players:GetPlayers()) do
    if plr.Character then setupDiedDetect(plr, plr.Character) end
    plr.CharacterAdded:Connect(function(char) setupDiedDetect(plr, char) end)
end

