    -- FunÃ§Ã£o para toggle BH
    local function bhToggle(parent, labelOff, labelOn, order, cb)
        local state = false
        local b = bhBtn(parent, labelOff, order)
        b.MouseButton1Click:Connect(function()
            state = not state
            b.Text = state and labelOn or labelOff
            if state then
                TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 90, 35)}):Play()
            else
                TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(18, 55, 22)}):Play()
            end
            if cb then cb(state) end
        end)
        return b, function() return state end
    end

