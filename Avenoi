    local btnIcon = newLabel(btn, icon, UDim2.new(1,0,0,38), UDim2.new(0,0,0,6), 20, THEME.TEXT_DIM)
    local btnText = newLabel(btn, name, UDim2.new(1,0,0,22), UDim2.new(0,0,1,-26), 10, THEME.TEXT_DIM)

    local indicator = Instance.new("Frame", btn)
    indicator.Size = UDim2.new(0, 3, 0.65, 0)
    indicator.Position = UDim2.new(0, 0, 0.175, 0)
    indicator.BackgroundColor3 = THEME.ACCENT1
    indicator.Visible = false
    corner(indicator, 3)

    -- PÃ¡gina de conteÃºdo
    local page = Instance.new("ScrollingFrame", content)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = THEME.ACCENT1
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false

    local pageLayout = Instance.new("UIListLayout", page)
    pageLayout.Padding = UDim.new(0, 8)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    Instance.new("UIPadding", page).PaddingTop = UDim.new(0, 6)

    local tab = { btn=btn, page=page, icon=btnIcon, text=btnText, indicator=indicator, name=name }
    table.insert(tabs, tab)

    btn.MouseButton1Click:Connect(function()
        if activeTab == tab then return end
        -- Desativar anterior
        if activeTab then
            activeTab.page.Visible = false
            tween(activeTab.btn, {BackgroundColor3 = THEME.CARD}, 0.18)
            tween(activeTab.icon, {TextColor3 = THEME.TEXT_DIM}, 0.18)
            tween(activeTab.text, {TextColor3 = THEME.TEXT_DIM}, 0.18)
            activeTab.indicator.Visible = false
        end
        -- Ativar novo
        activeTab = tab
        page.Visible = true
        tween(btn, {BackgroundColor3 = THEME.BORDER}, 0.18)
        tween(btnIcon, {TextColor3 = THEME.ACCENT2}, 0.18)
        tween(btnText, {TextColor3 = THEME.WHITE}, 0.18)
        indicator.Visible = true
    end)

    return tab
end

