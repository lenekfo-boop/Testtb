local function corner(p, r)
    local c = Instance.new("UICorner", p)
    c.CornerRadius = UDim.new(0, r or 8)
    return c
end

local function stroke(p, col, t)
    local s = Instance.new("UIStroke", p)
    s.Color = col or C.BORDER
    s.Thickness = t or 1.5
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

local function grad(p, c0, c1, rot)
    local g = Instance.new("UIGradient", p)
    g.Color = ColorSequence.new(c0, c1)
    g.Rotation = rot or 0
    return g
end

local function tw(obj, props, t, sty, dir)
    local ok2, err = pcall(function()
        TweenService:Create(obj, TweenInfo.new(
            t or 0.2,
            sty or Enum.EasingStyle.Quad,
            dir or Enum.EasingDirection.Out
        ), props):Play()
    end)
end

local function lbl(parent, text, size, pos, fs, col, xalign)
    local l = Instance.new("TextLabel", parent)
    l.Size = size
    l.Position = pos or UDim2.new(0,0,0,0)
    l.Text = text
    l.TextSize = fs or 13
    l.TextColor3 = col or C.TEXT
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamBold
    l.TextXAlignment = xalign or Enum.TextXAlignment.Center
    l.TextYAlignment = Enum.TextYAlignment.Center
    return l
end

local function mkBtn(parent, text, size, pos, bg, fs)
    local b = Instance.new("TextButton", parent)
    b.Size = size
    b.Position = pos or UDim2.new(0,0,0,0)
    b.Text = text
    b.TextSize = fs or 12
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = C.WHITE
    b.BackgroundColor3 = bg or C.CARD
    b.AutoButtonColor = false
    corner(b, 8)
    b.MouseEnter:Connect(function() tw(b, {BackgroundTransparency=0.2}, 0.12) end)
    b.MouseLeave:Connect(function() tw(b, {BackgroundTransparency=0}, 0.12) end)
    b.MouseButton1Down:Connect(function() tw(b, {BackgroundTransparency=0.45}, 0.07) end)
    b.MouseButton1Up:Connect(function() tw(b, {BackgroundTransparency=0}, 0.1) end)
    return b
end

local function actionBtn(parent, text, color, lo, cb)
    local b = mkBtn(parent, text, UDim2.new(1,0,0,32), nil, color)
    b.LayoutOrder = lo or 99
    if cb then b.MouseButton1Click:Connect(cb) end
    return b
end

local function toggleBtnFn(parent, lblOff, lblOn, cOff, cOn, lo, cb)
    local state = false
    local b = actionBtn(parent, lblOff, cOff, lo)
    b.MouseButton1Click:Connect(function()
        state = not state
        b.Text = state and lblOn or lblOff
        tw(b, {BackgroundColor3 = state and cOn or cOff}, 0.18)
        if cb then cb(state) end
    end)
    return b, function() return state end
end

local function textbox(parent, placeholder, lo)
    local t = Instance.new("TextBox", parent)
    t.Size = UDim2.new(1,0,0,32)
    t.BackgroundColor3 = C.BG
    t.TextColor3 = C.TEXT
    t.TextSize = 12
    t.Font = Enum.Font.Gotham
    t.PlaceholderText = placeholder or ""
    t.PlaceholderColor3 = C.DIM
    t.ClearTextOnFocus = false
    t.LayoutOrder = lo or 99
    corner(t, 7)
    return t
end

local function progressBar(parent, lo, accent)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1,0,0,30)
    wrap.BackgroundColor3 = C.BG
    wrap.LayoutOrder = lo or 99
    corner(wrap, 8)
    local fill = Instance.new("Frame", wrap)
    fill.Size = UDim2.new(0,0,1,0)
    fill.BackgroundColor3 = accent or C.A1
    fill.BorderSizePixel = 0
    corner(fill, 8)
    local lb = lbl(wrap, "", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), 12, C.WHITE)
    return wrap, fill, lb
end

local function section(page, title)
    local card = Instance.new("Frame", page)
    card.Size = UDim2.new(1,-4,0,0)
    card.AutomaticSize = Enum.AutomaticSize.Y
    card.BackgroundColor3 = C.CARD
    card.LayoutOrder = #page:GetChildren()
    corner(card, 10)
    stroke(card, C.BORDER, 1)

    local inner = Instance.new("Frame", card)
    inner.Size = UDim2.new(1,-16,0,0)
    inner.Position = UDim2.new(0,8,0,0)
    inner.AutomaticSize = Enum.AutomaticSize.Y
    inner.BackgroundTransparency = 1

    local il = Instance.new("UIListLayout", inner)
    il.Padding = UDim.new(0,6)
    il.SortOrder = Enum.SortOrder.LayoutOrder
    local ip = Instance.new("UIPadding", inner)
    ip.PaddingTop = UDim.new(0,8)
    ip.PaddingBottom = UDim.new(0,8)

    if title then
        local tl = lbl(inner, "â–¸  "..title, UDim2.new(1,0,0,18), nil, 11, C.A2, Enum.TextXAlignment.Left)
        tl.LayoutOrder = 0
        local sep = Instance.new("Frame", inner)
        sep.Size = UDim2.new(1,0,0,1)
        sep.BackgroundColor3 = C.BORDER
        sep.BorderSizePixel = 0
        sep.LayoutOrder = 1
    end
    return inner
end

