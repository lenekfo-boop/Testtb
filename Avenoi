                else notify("ADM","ID não detectado",2) end
            end)
        end
        if #found==0 then mkLabel(tlF,"Nenhuma tool no mapa",UDim2.new(1,0,0,28),nil,11,C.DIM) end
        notify("ADM Scanner","Scan: "..#found.." tools",3)
    end
    aBtn(s2,"🔍 Escanear Mapa",C.ACC,3,function() task.spawn(admScan) end)

