-- FunÃ§Ã£o para verificar se pode alertar (cooldown de 5 segundos por dupla)
local function canAlert(trollName, victimName)
    local key = trollName .. "->" .. victimName
    if not lastTrollAlert[key] then return true end
    return (tick() - lastTrollAlert[key]) > 5
end

