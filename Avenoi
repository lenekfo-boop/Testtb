    -- âš½ SOCCER BALL (Bola de Futebol)
    -- Segura a bola e fica chutando no alvo selecionado
    -- A bola vai atÃ© o alvo, o alvo "chuta" de volta, etc.
    -- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    local sSoccer=section(bhTab.page,"âš½ Soccer Ball (Futebol)")
    lbl(sSoccer,"â„¹ï¸ Selecione o alvo acima. O script pega a bola\ndo mapa e a teleporta em direÃ§Ã£o ao alvo\ntoda hora. Parece que vocÃªs estÃ£o jogando bola!",UDim2.new(1,0,0,44),nil,9,C.DIM).LayoutOrder=2

    local soccerActive=false
