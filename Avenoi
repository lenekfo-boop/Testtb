local antiGlobal  = true
local lastAlert   = {}
local proxTime    = {}

-- ═══════════════════════════════════════
-- ANTI-TROLL ENGINE
-- ═══════════════════════════════════════
local function canAlert(a, b)
    local k = a.."->"..b
    if not lastAlert[k] then return true end
    return (tick()-lastAlert[k]) > 6
end
local function setupTrollDetect(p)
    p.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
        hum.Died:Connect(function()
            if not antiTrollOn then return end
            if p == plr and not antiGlobal then return end
            task.wait(0.1)
            for _, op in pairs(Players:GetPlayers()) do
                if op ~= p and op.Character then
                    local oH = op.Character:FindFirstChild("HumanoidRootPart")
                    local vH = char:FindFirstChild("HumanoidRootPart")
                    if oH and vH and (oH.Position-vH.Position).Magnitude < 16 and canAlert(op.Name,p.Name) then
                        notifyTroll(op.Name, p==plr and "Te matou!" or "Matou "..p.DisplayName.."!")
                        lastAlert[op.Name.."->"..p.Name] = tick(); break
                    end
                end
            end
        end)
    end)
end
Players.PlayerAdded:Connect(setupTrollDetect)
for _, p in pairs(Players:GetPlayers()) do setupTrollDetect(p) end

task.spawn(function()
    while task.wait(0.45) do
        if not antiTrollOn then continue end
        for _, victim in pairs(Players:GetPlayers()) do
            if not antiGlobal and victim ~= plr then continue end
            local vc = victim.Character; if not vc then continue end
            local vH = vc:FindFirstChild("HumanoidRootPart"); if not vH then continue end
            for _, troll in pairs(Players:GetPlayers()) do
                if troll == victim then continue end
                local tc = troll.Character; if not tc then continue end
                local tH = tc:FindFirstChild("HumanoidRootPart"); if not tH then continue end
                local dist = (tH.Position-vH.Position).Magnitude
                local hd   = tH.Position.Y - vH.Position.Y
                if hd>3 and hd<8 and dist<5 and canAlert(troll.Name,victim.Name) then
                    notifyTroll(troll.Name, victim==plr and "Pulou em cima de você!" or "Pulou em "..victim.DisplayName.."!")
                    lastAlert[troll.Name.."->"..victim.Name]=tick()
                end
                local k = troll.Name.."_"..victim.Name
                if dist < 4 then
                    proxTime[k] = proxTime[k] or tick()
                    if (tick()-proxTime[k])>3 and canAlert(troll.Name,victim.Name) then
                        notifyTroll(troll.Name, victim==plr and "Perseguindo você!" or "Perseguindo "..victim.DisplayName.."!")
                        lastAlert[troll.Name.."->"..victim.Name]=tick(); proxTime[k]=nil
                    end
                else proxTime[k]=nil end
                if vH.AssemblyLinearVelocity.Magnitude>55 and dist<9 and canAlert(troll.Name,victim.Name) then
                    notifyTroll(troll.Name, victim==plr and "Te empurrou!" or "Empurrou "..victim.DisplayName.."!")
                    lastAlert[troll.Name.."->"..victim.Name]=tick()
                end
            end
        end
    end
end)

-- ═══════════════════════════════════════
-- ESP ENGINE (server-side + cor editável)
-- ═══════════════════════════════════════
local function buildESP(p)
    if not p.Character then return end
    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    -- remove antigo
    local old = hrp:FindFirstChild("AvenESP_BB")
    if old then old:Destroy() end
    local bb = Instance.new("BillboardGui", hrp)
    bb.Name = "AvenESP_BB"; bb.Size = UDim2.new(0,100,0,32)
    bb.StudsOffset = Vector3.new(0,4,0); bb.AlwaysOnTop = true
    local nl = Instance.new("TextLabel", bb)
    nl.Size = UDim2.new(1,0,1,0); nl.BackgroundTransparency = 1
    nl.Text = p.Name; nl.Font = Enum.Font.GothamBold; nl.TextScaled = true
    nl.TextColor3 = espColor; nl.TextStrokeTransparency = 0.4
    table.insert(espObjects, bb)
    -- box highlight
    local hl = Instance.new("SelectionBox", p.Character)
    hl.Name = "AvenESP_HLBox"; hl.Adornee = p.Character
    hl.Color3 = espColor; hl.LineThickness = 0.06
    hl.SurfaceTransparency = 0.82; hl.SurfaceColor3 = espColor
    table.insert(espObjects, hl)
end

local function clearESP()
    for _, v in pairs(espObjects) do
        if v and v.Parent then v:Destroy() end
    end
    espObjects = {}
end

local function refreshESP()
    clearESP()
    if not espActive then return end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= plr then buildESP(p) end
    end
end

-- Atualiza cor de todos os ESPs ativos
local function updateESPColor()
    for _, v in pairs(espObjects) do
        if v and v.Parent then
            if v:IsA("BillboardGui") then
                local nl = v:FindFirstChildOfClass("TextLabel")
                if nl then nl.TextColor3 = espColor end
            elseif v:IsA("SelectionBox") then
                v.Color3 = espColor; v.SurfaceColor3 = espColor
            end
        end
    end
end

-- Loop de refresh do ESP (quando ativo)
task.spawn(function()
    while true do
        task.wait(3)
        if espActive then refreshESP() end
    end
end)
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() task.wait(1); if espActive then buildESP(p) end end)
end)

