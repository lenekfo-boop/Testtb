                if oH and vH and (oH.Position-vH.Position).Magnitude<15 and canAlert(op.Name,p.Name) then
                    notifyTroll(op.Name,p==plr and "Te matou!" or "Matou "..p.DisplayName.."!"); lastAlert[op.Name.."->"..p.Name]=tick(); break
