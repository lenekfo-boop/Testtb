    local fg = 1/#fP
    for i,p in ipairs(fP) do
        mkBtn(rf,p[1],UDim2.new(fg,-3,1,0),UDim2.new((i-1)*fg,1,0,0),p[2]).MouseButton1Click:Connect(function()
            p[3](); updateFlyUI()
        end)
    end

    local hintLbl = lbl(s,
        "W/A/S/D = direÃ§Ã£o   SPACE = subir   CTRL/SHIFT = descer\nVoo suavizado com inÃ©rcia realista",
        UDim2.new(1,0,0,30), nil, 10, C.DIM)
    hintLbl.TextWrapped = true; hintLbl.LayoutOrder = 7

    actionBtn(s, "ðŸ–¥ï¸  Abrir Mini Painel", C.A1, 8, function()
        if not miniPanel or not miniPanel.Parent then createMiniPanel() end
    end)

    -- â”€â”€ COMANDOS DE CHAT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
