            mkLabel(row,"🔧 "..tName,UDim2.new(0.60,0,0.5,0),UDim2.new(0,8,0,0),11,C.TEXT,Enum.TextXAlignment.Left)
            -- Detectar ID
            local toolId="?"; pcall(function()
                local h=tool:FindFirstChild("Handle"); if h then local m=h:FindFirstChildOfClass("SpecialMesh"); if m then toolId=m.MeshId:match("%d+") or "?" end end
