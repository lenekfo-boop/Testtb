    -- â”€â”€ LOOP DE VOO REALISTA (inÃ©rcia suavizada) â”€
    local flyConn = nil

    startFlyFn = function()
        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        cleanFlyForces()

        -- BodyVelocity
        flyBV = Instance.new("BodyVelocity", hrp)
        flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        flyBV.Velocity  = Vector3.new(0,0,0)

        -- BodyGyro (estabiliza a rotaÃ§Ã£o, nÃ£o deixa tombar)
        flyBG = Instance.new("BodyGyro", hrp)
        flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        flyBG.P          = 3000
        flyBG.D          = 200
        flyBG.CFrame     = hrp.CFrame

        flying     = true
        currentVel = Vector3.new(0,0,0)
        setFlyAnim(true)
        updateMiniBtn()

        -- Desconectar loop anterior se existir
        if flyConn then flyConn:Disconnect(); flyConn=nil end

        flyConn = RunService.Heartbeat:Connect(function(dt)
            if not flying then flyConn:Disconnect(); flyConn=nil; return end

            local char2 = player.Character
            local hrp2  = char2 and char2:FindFirstChild("HumanoidRootPart")
            if not hrp2 or not flyBV or not flyBV.Parent then
                stopFlyFn(); return
            end

            local cam = workspace.CurrentCamera
            local lookDir = cam.CFrame.LookVector
            local rightDir = cam.CFrame.RightVector

            -- Determinar direÃ§Ã£o desejada a partir das teclas
            local wishDir = Vector3.new(0,0,0)

            if UIS:IsKeyDown(Enum.KeyCode.W) then
                wishDir = wishDir + lookDir
            end
            if UIS:IsKeyDown(Enum.KeyCode.S) then
                wishDir = wishDir - lookDir
            end
            if UIS:IsKeyDown(Enum.KeyCode.A) then
                wishDir = wishDir - rightDir
            end
            if UIS:IsKeyDown(Enum.KeyCode.D) then
                wishDir = wishDir + rightDir
            end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then
                wishDir = wishDir + Vector3.new(0,1,0)
            end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
                wishDir = wishDir + Vector3.new(0,-1,0)
            end

            -- Normalizar e aplicar velocidade desejada
            local targetVel
            if wishDir.Magnitude > 0.01 then
                targetVel = wishDir.Unit * flySpeed
            else
                -- Sem input: desacelera gradualmente (planagem)
                targetVel = Vector3.new(0,0,0)
            end

            -- SuavizaÃ§Ã£o (lerp) â€” fator baseado no dt para ser frame-rate independent
            -- aceleraÃ§Ã£o rÃ¡pida, desaceleraÃ§Ã£o mais suave (realismo)
            local lerpAcc = wishDir.Magnitude > 0.01 and 8 or 5
            currentVel = currentVel:Lerp(targetVel, math.min(dt * lerpAcc, 1))

            flyBV.Velocity = currentVel

            -- Gyro: alinhar HRP com a cÃ¢mera horizontalmente (sem inclinar pro chÃ£o)
            local flatLook = Vector3.new(lookDir.X, 0, lookDir.Z)
            if flatLook.Magnitude > 0.01 then
                flyBG.CFrame = CFrame.lookAt(hrp2.Position, hrp2.Position + flatLook)
            end

            -- Pequena inclinaÃ§Ã£o visual para frente quando em movimento horizontal
            local hVel = Vector3.new(currentVel.X, 0, currentVel.Z)
            if hVel.Magnitude > 2 then
                local tiltAngle = math.clamp(hVel.Magnitude / flySpeed * 0.18, 0, 0.18)
                flyBG.CFrame = flyBG.CFrame * CFrame.Angles(-tiltAngle, 0, 0)
            end
        end)
    end

    stopFlyFn = function()
        flying = false
        if flyConn then flyConn:Disconnect(); flyConn=nil end
        cleanFlyForces()
        setFlyAnim(false)
        currentVel = Vector3.new(0,0,0)
        updateMiniBtn()
    end

    -- â”€â”€ ABA NA GUI PRINCIPAL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
