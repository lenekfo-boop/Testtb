local uniTab = newTab("Universal","🌍")
do
    -- Pegar tools
    local function pegaTool(tool)
        local ok2=false
        pcall(function()
            local hrp=getHRP(); local bp=getBP(); if not hrp or not bp then return end
            local handle=nil; pcall(function() handle=tool.Handle end)
            if handle and handle.Parent then hrp.CFrame=handle.CFrame*CFrame.new(0,4,0); task.wait(0.15) end
            tool.Parent=bp; ok2=true
        end)
        if not ok2 then pcall(function()
            local re=RepStor:FindFirstChild("RE"); if not re then return end
            for _,n in ipairs({"PickupTool","GrabTool","PickUp","Pickup","GetTool"}) do
                local ev=re:FindFirstChild(n); if ev then ev:FireServer(tool); task.wait(0.12); if tool.Parent==getBP() then ok2=true; return end end
            end
        end) end
        if not ok2 then pcall(function() tool.Parent=getBP(); ok2=true end) end
        return ok2
    end
    local function getWSTtools()
        local list={}; local seen={}
        for _,obj in pairs(WS:GetDescendants()) do
            if (obj:IsA("Tool") or obj:IsA("HopperBin")) and not seen[obj] then
                local owned=false
                for _,p in pairs(Players:GetPlayers()) do if obj.Parent==p.Backpack or obj.Parent==p.Character then owned=true; break end end
                if not owned then seen[obj]=true; table.insert(list,obj) end
            end
        end
        return list
    end

    -- Scanner de tools
    local s = mkSec(uniTab.page,"🔧 Tools Scanner")
    local countL = mkLabel(s,"",UDim2.new(1,0,0,22),nil,11,C.DIM); countL.LayoutOrder=2
    local listF = Instance.new("Frame",s); listF.Size=UDim2.new(1,0,0,0); listF.AutomaticSize=Enum.AutomaticSize.Y; listF.BackgroundTransparency=1; listF.LayoutOrder=4
    Instance.new("UIListLayout",listF).Padding=UDim.new(0,4)

    local function scanTools()
        for _,v in pairs(listF:GetChildren()) do if not v:IsA("UIListLayout") then v:Destroy() end end
        local tools=getWSTtools(); local hrp=getHRP()
        countL.Text="🔍 Tools no mapa: "..#tools; countL.TextColor3=#tools>0 and C.GREEN or C.DIM
        for i, tool in ipairs(tools) do
            local h=nil; pcall(function() h=tool:FindFirstChild("Handle") end)
            local pos=h and h.Position or (tool.PrimaryPart and tool.PrimaryPart.Position)
            local dist=pos and hrp and math.floor((hrp.Position-pos).Magnitude) or "?"
            local row=Instance.new("Frame",listF); row.Size=UDim2.new(1,0,0,44); row.BackgroundColor3=C.CARD2; row.LayoutOrder=i; corner(row,8); stroke(row,C.BORDER,1)
            mkLabel(row,"🔧 "..tool.Name,UDim2.new(0.60,0,0.5,0),UDim2.new(0,8,0,0),11,C.TEXT,Enum.TextXAlignment.Left)
            mkLabel(row,tostring(dist).."m",UDim2.new(0,32,1,0),UDim2.new(1,-120,0,0),10,C.ACC2)
            local pb=mkBtn(row,"⬇ PEGAR",UDim2.new(0,70,0,30),UDim2.new(1,-78,0.5,-15),C.GREEN,10); pb.ZIndex=2
            pb.MouseButton1Click:Connect(function()
                local ok3=pegaTool(tool)
                if ok3 then pb.Text="✅"; tw(pb,{BackgroundColor3=Color3.fromRGB(8,60,12)},0.15); notify("Tool","🔧 "..tool.Name.." pego!",2)
                else pb.Text="❌"; tw(pb,{BackgroundColor3=C.RED},0.15) end
                task.wait(1.5); pcall(scanTools)
            end)
        end
        if #tools==0 then mkLabel(listF,"Nenhuma tool no mapa",UDim2.new(1,0,0,28),nil,11,C.DIM).LayoutOrder=1 end
    end
