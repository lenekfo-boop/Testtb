-- HELPERS UI
-- ═══════════════════════════════════════
local function corner(p, r)
    local u = Instance.new("UICorner", p)
    u.CornerRadius = UDim.new(0, r or 8)
    return u
end

local function stroke(p, col, th)
    local s = Instance.new("UIStroke", p)
    s.Color = col or C.BORDER; s.Thickness = th or 1.5
    return s
end

local function tw(obj, props, t, style, dir)
    pcall(function()
        TweenSvc:Create(obj,
            TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
            props):Play()
    end)
end

local function startRGB(strk, spd)
    task.spawn(function()
        local h = 0
        while strk and strk.Parent do
            h = (h + (spd or 1)) % 360
            strk.Color = Color3.fromHSV(h/360, 1, 1)
            task.wait(0.04)
        end
    end)
end

local function mkLabel(par, txt, sz, pos, fs, col, xa)
    local l = Instance.new("TextLabel", par)
    l.Size = sz; l.Position = pos or UDim2.new(0,0,0,0)
    l.Text = txt; l.TextSize = fs or 12
    l.TextColor3 = col or C.TEXT
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamBold
    l.TextXAlignment = xa or Enum.TextXAlignment.Center
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.TextWrapped = false
    return l
end

local function mkBtn(par, txt, sz, pos, bg, fs)
    local b = Instance.new("TextButton", par)
    b.Size = sz; b.Position = pos or UDim2.new(0,0,0,0)
    b.Text = txt; b.TextSize = fs or 12
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = C.WHITE
    b.BackgroundColor3 = bg or C.CARD2
    b.AutoButtonColor = false
    corner(b, 8)
    b.MouseEnter:Connect(function() tw(b, {BackgroundTransparency=0.2}, 0.1) end)
    b.MouseLeave:Connect(function() tw(b, {BackgroundTransparency=0},   0.1) end)
    return b
end

-- Botão de ação padronizado (ocupa linha inteira)
local function aBtn(par, txt, col, lo, cb)
    local b = mkBtn(par, txt, UDim2.new(1,0,0,36), nil, col, 12)
    b.LayoutOrder = lo or 99
    if cb then b.MouseButton1Click:Connect(cb) end
    return b
end

-- Toggle padronizado
local function togBtn(par, offT, onT, offC, onC, lo, cb)
    local state = false
    local b = aBtn(par, offT, offC, lo)
    b.MouseButton1Click:Connect(function()
        state = not state
        b.Text = state and ("✅  "..onT) or ("○  "..offT)
        tw(b, {BackgroundColor3 = state and onC or offC}, 0.15)
        if cb then cb(state, b) end
    end)
    b.Text = "○  "..offT
    return b, function() return state end
end

-- TextBox padronizado
local function mkTbox(par, ph, lo)
    local t = Instance.new("TextBox", par)
    t.Size = UDim2.new(1,0,0,36)
    t.BackgroundColor3 = C.BG
    t.TextColor3 = C.TEXT; t.TextSize = 12
    t.Font = Enum.Font.Gotham
    t.PlaceholderText = ph or ""; t.PlaceholderColor3 = C.DIM
    t.ClearTextOnFocus = false; t.LayoutOrder = lo or 99
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextWrapped = false
    corner(t, 7); stroke(t, C.ACC, 1)
    local pad = Instance.new("UIPadding", t)
    pad.PaddingLeft = UDim.new(0, 10)
    return t
end

-- Seção / Card com título
local function mkSec(page, title, cbg, bc, tc)
    local card = Instance.new("Frame", page)
    card.Size = UDim2.new(1,-6,0,0)
    card.AutomaticSize = Enum.AutomaticSize.Y
    card.BackgroundColor3 = cbg or C.CARD
    card.LayoutOrder = #page:GetChildren()
    corner(card, 10); stroke(card, bc or C.BORDER, 1)

    local inner = Instance.new("Frame", card)
    inner.Size = UDim2.new(1,-14,0,0)
    inner.Position = UDim2.new(0,7,0,0)
    inner.AutomaticSize = Enum.AutomaticSize.Y
    inner.BackgroundTransparency = 1

    local il = Instance.new("UIListLayout", inner)
    il.Padding = UDim.new(0,7); il.SortOrder = Enum.SortOrder.LayoutOrder
    local ip = Instance.new("UIPadding", inner)
    ip.PaddingTop = UDim.new(0,10); ip.PaddingBottom = UDim.new(0,10)

    if title and title ~= "" then
        local hf = Instance.new("Frame", inner)
        hf.Size = UDim2.new(1,0,0,20)
        hf.BackgroundTransparency = 1; hf.LayoutOrder = 0
        mkLabel(hf,"▍",UDim2.new(0,12,1,0),UDim2.new(0,0,0,0),14,tc or C.ACC)
        mkLabel(hf,title,UDim2.new(1,-16,1,0),UDim2.new(0,14,0,0),12,tc or C.ACC2,Enum.TextXAlignment.Left)
        local sep = Instance.new("Frame",inner)
        sep.Size = UDim2.new(1,0,0,1); sep.BackgroundColor3 = bc or C.BORDER
        sep.BorderSizePixel = 0; sep.LayoutOrder = 1
    end
    return inner
end

-- Grid 2 colunas
