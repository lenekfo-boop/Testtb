local function createTab(name, icon, order)
    local tabData = {name = name, page = nil, button = nil}

    local btn = Instance.new("TextButton", sidebar)
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(25, 30, 35)
    btn.Text = ""
    btn.LayoutOrder = order
    btn.AutoButtonColor = false
    corner(btn, 8)

    local btnIcon = Instance.new("TextLabel", btn)
    btnIcon.Size = UDim2.new(0, 30, 1, 0)
    btnIcon.Position = UDim2.new(0, 10, 0, 0)
    btnIcon.Text = icon
    btnIcon.Font = Enum.Font.GothamBold
    btnIcon.TextSize = 16
    btnIcon.TextColor3 = C.DIM
    btnIcon.BackgroundTransparency = 1

    local btnText = Instance.new("TextLabel", btn)
    btnText.Size = UDim2.new(1, -45, 1, 0)
    btnText.Position = UDim2.new(0, 45, 0, 0)
    btnText.Text = name
    btnText.Font = Enum.Font.Gotham
    btnText.TextSize = 13
    btnText.TextColor3 = C.DIM
    btnText.TextXAlignment = Enum.TextXAlignment.Left
    btnText.BackgroundTransparency = 1

    local page = Instance.new("ScrollingFrame", content)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 6
    page.ScrollBarImageColor3 = C.PURPLE
    page.Visible = false
    page.CanvasSize = UDim2.new(0, 0, 0, 0)

    local pageLayout = Instance.new("UIListLayout", page)
    pageLayout.Padding = UDim.new(0, 10)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    local pagePad = Instance.new("UIPadding", page)
    pagePad.PaddingTop = UDim.new(0, 5)
    pagePad.PaddingBottom = UDim.new(0, 10)

    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 20)
    end)

    tabData.page = page
    tabData.button = btn
    tabs[name] = tabData

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.page.Visible = false
            t.button.BackgroundColor3 = Color3.fromRGB(25, 30, 35)
            for _, child in pairs(t.button:GetChildren()) do
                if child:IsA("TextLabel") then child.TextColor3 = C.DIM end
            end
        end
        page.Visible = true
        btn.BackgroundColor3 = C.PURPLE
        btnIcon.TextColor3 = C.TEXT
        btnText.TextColor3 = C.TEXT
        currentTab = tabData
    end)

    return tabData
end

local function section(page, title)
    local sec = Instance.new("Frame", page)
    sec.Size = UDim2.new(1, -10, 0, 0)
    sec.AutomaticSize = Enum.AutomaticSize.Y
    sec.BackgroundColor3 = C.CARD
    sec.BorderSizePixel = 0
    corner(sec, 10)
    stroke(sec, C.BORDER, 1)

    if title and title ~= "" then
        local secTitle = Instance.new("TextLabel", sec)
        secTitle.Size = UDim2.new(1, 0, 0, 35)
        secTitle.Text = "  " .. title
        secTitle.Font = Enum.Font.GothamBold
        secTitle.TextSize = 14
        secTitle.TextColor3 = C.PURPLE
        secTitle.BackgroundTransparency = 1
        secTitle.TextXAlignment = Enum.TextXAlignment.Left
        secTitle.LayoutOrder = 0
    end

    local secLayout = Instance.new("UIListLayout", sec)
    secLayout.Padding = UDim.new(0, 5)
    secLayout.SortOrder = Enum.SortOrder.LayoutOrder
    local secPad = Instance.new("UIPadding", sec)
    secPad.PaddingLeft = UDim.new(0, 10)
    secPad.PaddingRight = UDim.new(0, 10)
    secPad.PaddingBottom = UDim.new(0, 8)

    return sec
end

local function actionBtn(parent, text, color, order, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.TextColor3 = C.TEXT
    btn.LayoutOrder = order
    btn.AutoButtonColor = false
    corner(btn, 8)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.2}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
    end)

    if callback then btn.MouseButton1Click:Connect(callback) end
    return btn
end

