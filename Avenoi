            for _, troll in pairs(Players:GetPlayers()) do
                if troll == victim then continue end
                local trollChar = troll.Character
                if not trollChar then continue end
                local trollHRP = trollChar:FindFirstChild("HumanoidRootPart")
                local trollHum = trollChar:FindFirstChildOfClass("Humanoid")
                if not trollHRP or not trollHum then continue end
                local distance = (trollHRP.Position - victimHRP.Position).Magnitude
                local heightDiff = trollHRP.Position.Y - victimHRP.Position.Y
                if heightDiff > 3 and heightDiff < 8 and distance < 5 then
                    if canAlert(troll.Name, victim.Name) then
