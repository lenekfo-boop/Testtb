local function corner(p,r) local c=Instance.new("UICorner",p); c.CornerRadius=UDim.new(0,r or 8); return c end
local function stroke(p,col,t) local s=Instance.new("UIStroke",p); s.Color=col or C.BORDER; s.Thickness=t or 1.5; return s end
local function grad(p,c0,c1,rot) local g=Instance.new("UIGradient",p); g.Color=ColorSequence.new(c0,c1); g.Rotation=rot or 0; return g end

local function tw(obj,props,t,style,dir)
    pcall(function() TweenService:Create(obj,TweenInfo.new(t or 0.2,style or Enum.EasingStyle.Quad,dir or Enum.EasingDirection.Out),props):Play() end)
end

local function lbl(parent,text,size,pos,fs,col,xa)
    local l=Instance.new("TextLabel",parent)
    l.Size=size; l.Position=pos or UDim2.new(0,0,0,0); l.Text=text; l.TextSize=fs or 12
    l.TextColor3=col or C.TEXT; l.BackgroundTransparency=1; l.Font=Enum.Font.GothamBold
    l.TextXAlignment=xa or Enum.TextXAlignment.Center; l.TextYAlignment=Enum.TextYAlignment.Center
    l.TextWrapped=false; return l
end

local function mkBtn(parent,text,size,pos,bg,fs,textCol)
    local b=Instance.new("TextButton",parent)
    b.Size=size; b.Position=pos or UDim2.new(0,0,0,0); b.Text=text; b.TextSize=fs or 12
    b.Font=Enum.Font.GothamBold; b.TextColor3=textCol or C.WHITE; b.BackgroundColor3=bg or C.CARD; b.AutoButtonColor=false
    corner(b,8)
    b.MouseEnter:Connect(function() tw(b,{BackgroundTransparency=0.25},0.12) end)
    b.MouseLeave:Connect(function() tw(b,{BackgroundTransparency=0},0.12) end)
    return b
end

local function aBtn(parent,text,color,lo,cb,textCol)
    local b=mkBtn(parent,text,UDim2.new(1,0,0,34),nil,color,12,textCol)
    b.LayoutOrder=lo or 99; if cb then b.MouseButton1Click:Connect(cb) end; return b
end

local function togBtn(parent,offT,onT,offC,onC,lo,cb)
    local state=false
    local b=aBtn(parent,offT,offC,lo)
    b.MouseButton1Click:Connect(function()
        state=not state; b.Text=state and onT or offT; tw(b,{BackgroundColor3=state and onC or offC},0.15)
        if cb then cb(state) end
    end)
    return b, function() return state end
end

local function tbox(parent,placeholder,lo)
    local t=Instance.new("TextBox",parent)
    t.Size=UDim2.new(1,0,0,36); t.BackgroundColor3=C.BG; t.TextColor3=C.TEXT
