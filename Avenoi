local function createTab(name, icon)
    -- BotÃ£o lateral
    local btn = Instance.new("TextButton", sidebar)
    btn.Size = UDim2.new(0, 94, 0, 68)
    btn.Text = ""
    btn.BackgroundColor3 = THEME.CARD
