                    newBall.Color=Color3.fromRGB(255,255,255); newBall.BrickColor=BrickColor.new("White")
                    newBall.Elasticity=0.8; newBall.Friction=0.3
                    -- Posiciona na frente do player
                    local myHRP=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if myHRP then newBall.CFrame=myHRP.CFrame*CFrame.new(0,0,-3) end
                    ball=newBall
                end

                notify("Soccer","âš½ Jogando bola com "..(selectedPlayer or "alvo").. "!",3)

                -- Loop principal: fica chutando a bola em direÃ§Ã£o ao alvo
                local kickInterval=0.35  -- velocidade das "chutadas"
                local kickForce=180      -- forÃ§a do chute
                local lastKickTime=0

                while soccerActive do
                    task.wait(kickInterval)
                    if not soccerActive then break end

                    -- Valida bola
                    if not ball or not ball.Parent then
                        -- Tenta recriar
                        local newBall=Instance.new("Part",workspace)
                        newBall.Name="AvenSoccerBall"; newBall.Shape=Enum.PartType.Ball
                        newBall.Size=Vector3.new(1.5,1.5,1.5); newBall.Material=Enum.Material.SmoothPlastic
                        newBall.Color=Color3.fromRGB(255,255,255); newBall.Elasticity=0.8; newBall.Friction=0.3
                        local myHRP=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                        if myHRP then newBall.CFrame=myHRP.CFrame*CFrame.new(0,0,-3) end
                        ball=newBall
                    end

                    local myChar=player.Character
                    local myHRP=myChar and myChar:FindFirstChild("HumanoidRootPart")
                    if not myHRP then task.wait(0.5); continue end

                    -- Pega posiÃ§Ã£o do alvo
                    local targetHRP=nil
                    if selectedPlayer then
                        local tp=Players:FindFirstChild(selectedPlayer)
                        if tp and tp.Character then targetHRP=tp.Character:FindFirstChild("HumanoidRootPart") end
                    end

                    if targetHRP then
                        -- Teleporta a bola para entre o player e o alvo (efeito de chute contÃ­nuo)
                        local myPos=myHRP.Position
                        local tPos=targetHRP.Position
                        local dist=(tPos-myPos).Magnitude

                        -- Posiciona a bola entre os dois de forma dinÃ¢mica
                        local midPoint=myPos:Lerp(tPos, 0.5) + Vector3.new(0,1,0)
                        pcall(function() ball.CFrame=CFrame.new(midPoint) end)
                        task.wait(0.05)

                        -- Aplica velocidade em direÃ§Ã£o ao alvo
                        local dir=(tPos-myPos).Unit
                        local vel=dir*kickForce+Vector3.new(0,12,0)  -- pequeno arco
                        pcall(function() ball.AssemblyLinearVelocity=vel end)

                        -- Simula o "chute de volta": a bola vai atÃ© prÃ³ximo do alvo e "chuta de volta"
                        task.wait(kickInterval*0.5)
                        if soccerActive and ball and ball.Parent then
                            -- Rebote: direciona de volta para o player
                            local backDir=(myPos-tPos).Unit
                            local backVel=backDir*kickForce*0.8+Vector3.new(0,10,0)
                            pcall(function()
                                ball.CFrame=CFrame.new(tPos:Lerp(myPos,0.15)+Vector3.new(0,0.5,0))
                                ball.AssemblyLinearVelocity=backVel
                            end)
                        end
                    else
                        -- Sem alvo: bola fica circulando ao redor do player
                        local angle = (tick()*3) % (2*math.pi)
                        local radius = 4
                        local bPos = myHRP.Position + Vector3.new(math.cos(angle)*radius, 0.5, math.sin(angle)*radius)
                        pcall(function() ball.CFrame=CFrame.new(bPos); ball.AssemblyLinearVelocity=Vector3.new(0,5,0) end)
                    end
                end

                -- Ao desativar, limpa bola criada localmente
                if ball and ball.Parent and ball.Name=="AvenSoccerBall" then
                    ball:Destroy()
                end
                notify("Soccer","âš½ Soccer Ball desativado!",2)
            end)
        end
    end)

