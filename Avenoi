-- Helpers
local function corner(p,r) local c=Instance.new("UICorner",p); c.CornerRadius=UDim.new(0,r or 8); return c end
local function stroke(p,col,t) local s=Instance.new("UIStroke",p); s.Color=col or C.BORDER; s.Thickness=t or 1.5; return s end
local function grad(p,c0,c1,rot) local g=Instance.new("UIGradient",p); g.Color=ColorSequence.new(c0,c1); g.Rotation=rot or 0; return g end
local function tween(obj,props,t,style,dir)
    pcall(function()
        TweenService:Create(obj,TweenInfo.new(t or 0.2,style or Enum.EasingStyle.Quad,dir or Enum.EasingDirection.Out),props):Play()
    end)
end

local function lbl(parent,text,size,pos,fs,col,xalign)
    local l=Instance.new("TextLabel",parent)
    l.Size=size; l.Position=pos or UDim2.new(0,0,0,0); l.Text=text; l.TextSize=fs or 12
    l.TextColor3=col or C.TEXT; l.BackgroundTransparency=1; l.Font=Enum.Font.GothamBold
    l.TextXAlignment=xalign or Enum.TextXAlignment.Center
    l.TextYAlignment=Enum.TextYAlignment.Center
    return l
end

local function btn(parent,text,size,pos,bg,fs)
    local b=Instance.new("TextButton",parent)
    b.Size=size; b.Position=pos or UDim2.new(0,0,0,0); b.Text=text; b.TextSize=fs or 12
    b.Font=Enum.Font.GothamBold; b.TextColor3=C.WHITE; b.BackgroundColor3=bg or C.CARD
    b.AutoButtonColor=false; corner(b,8)
    b.MouseEnter:Connect(function() tween(b,{BackgroundTransparency=0.25},0.12) end)
    b.MouseLeave:Connect(function() tween(b,{BackgroundTransparency=0},0.12) end)
    return b
end

local function actionBtn(parent,text,color,lo,cb)
    local b=btn(parent,text,UDim2.new(1,0,0,32),nil,color)
    b.LayoutOrder=lo or 99
    if cb then b.MouseButton1Click:Connect(cb) end
    return b
end

local function toggleBtn(parent,offTxt,onTxt,offCol,onCol,lo,cb)
    local state=false
    local b=actionBtn(parent,offTxt,offCol,lo)
    b.MouseButton1Click:Connect(function()
        state=not state
        b.Text=state and onTxt or offTxt
        tween(b,{BackgroundColor3=state and onCol or offCol},0.15)
        if cb then cb(state) end
    end)
    return b,function() return state end
end

local function textbox(parent,placeholder,lo)
    local t=Instance.new("TextBox",parent)
    t.Size=UDim2.new(1,0,0,36); t.BackgroundColor3=C.BG; t.TextColor3=C.TEXT
    t.TextSize=12; t.Font=Enum.Font.Gotham; t.PlaceholderText=placeholder or ""
    t.PlaceholderColor3=C.DIM; t.ClearTextOnFocus=false; t.LayoutOrder=lo or 99
    t.TextWrapped=false; t.TextXAlignment=Enum.TextXAlignment.Left
