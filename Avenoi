                if not ok3 then pcall(function() tool.Parent=getBP(); ok3=true end) end
                if ok3 then getB.Text="✅"; tw(getB,{BackgroundColor3=Color3.fromRGB(8,60,12)},0.15); notify("ADM Tool","🔧 "..tName.." pego!",2)
                else getB.Text="❌"; tw(getB,{BackgroundColor3=C.RED},0.15) end
                task.wait(1.5); pcall(admScan)
            end)
            local cpB=mkBtn(row,"📋 ID",UDim2.new(0,44,0,30),UDim2.new(0.63,76,0.5,-15),C.ACC,10); cpB.ZIndex=2
            cpB.MouseButton1Click:Connect(function()
