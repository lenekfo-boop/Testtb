    -- â”€â”€ ATUALIZAR BOTÃƒO DO MINI PAINEL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    local function updateMiniBtn()
        if not miniPanelFlyToggle or not miniPanelFlyToggle.Parent then return end
