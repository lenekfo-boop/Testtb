                local owned=false; for _,p in pairs(Players:GetPlayers()) do if obj.Parent==p.Backpack or obj.Parent==p.Character then owned=true; break end end
                if not owned then pcall(function() obj.Parent=getBP() end) end
            end end
        end); task.wait(2) end end) end
    end)
end

